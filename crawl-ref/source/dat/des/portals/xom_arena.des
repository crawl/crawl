default-depth: Arena?

{{
function xom_arena_setup(e)
    e.tags("no_dump no_item_gen allow_dup")
    e.orient("encompass")
    e.kfeat("+ = closed_clear_door")
    e.kfeat("< = exit_xom_arena")
    e.kprop("1'< = no_tele_into")
    e.kmask("1'< = no_monster_gen")
    e.mons("generate_awake ugly_thing att:good_neutral")
    e.lua_marker("v", props_marker { veto_destroy="veto" })
end
}}

