###############################################################################
# Small vaults made specifically for D:1.
#
# Keep threats here limited to ordinary D:1 monsters. These maps intentionally
# do not extend into D:2, so the two floors retain separate vault pools.
###############################################################################

NAME:    dcchili_d1_kobold_camp
DEPTH:   D:1
WEIGHT:  20
CHANCE:  100%
TAGS:    chance_dcchili_d1
TAGS:    no_monster_gen no_item_gen transparent
MONS:    kobold
ITEM:    stone / nothing w:2
KMONS:   t = plant / bush
MAP
  ttt
 tt.tt
 t.1.t
 t.*.t
 tt.tt
  .@.
ENDMAP

