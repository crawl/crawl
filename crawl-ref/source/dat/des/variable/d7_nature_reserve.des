###############################################################################
# D:7 Nature Reserve
#
# Early-Dungeon animals grouped into habitats, with stronger specimens
# behind player-openable runed gates. Yaks are a modest D:8 preview.
###############################################################################

NAME:    dcchili_d7_nature_reserve
PLACE:   D:7
DEPTH:   D:7
WEIGHT:  5000
TAGS:    dcchili_d7_zoo no_monster_gen no_item_gen no_pool_fixup no_rotate
ORIENT:  float

# Loose animals in the normally generated portions of D:7.
MONS:    bullfrog w:10 / hound w:10 / iguana w:10 / adder w:8 / \
         scorpion w:8 / howler monkey w:6 / black bear w:4 / \
         water moccasin w:3 / bombardier beetle w:3

# A bullfrog pond.
KMONS:   1 = bullfrog
KMONS:   2 = bullfrog
KMONS:   3 = bullfrog
KMONS:   A = bullfrog

# Hounds and black bears.
KMONS:   4 = hound
KMONS:   5 = hound
KMONS:   6 = black bear
KMONS:   B = black bear

# Small snakes with a water moccasin as the stronger specimen.
KMONS:   7 = adder
KMONS:   8 = adder
KMONS:   9 = ball python
KMONS:   C = water moccasin

# Scorpions and beetles with a hornet as the stronger specimen.
KMONS:   a = scorpion
KMONS:   b = bombardier beetle
KMONS:   d = scorpion
KMONS:   D = hornet

# Small mammals with a single yak as the stronger specimen.
KMONS:   X = quokka w:3 / howler monkey w:1
KMONS:   E = yak

# A small reward tucked inside each habitat.
KITEM:   i = any potion w:4 / any scroll w:4 / gold w:3 / \
             any wand w:2 / any jewellery w:1

KFEAT:   c = rock_wall
KFEAT:   G = runed_clear_door
KFEAT:   t = tree
KFEAT:   w = shallow_water
KPROP:   123456789abdABCDEFX = no_tele_into
KMASK:   123456789abdABCDEFX = opaque
TILE:    c = wall_vines
FTILE:   .123456789abdiABCDEFXwt = floor_grass_dark
LROCKTILE: wall_vines
LFLOORTILE: floor_grass_dark

