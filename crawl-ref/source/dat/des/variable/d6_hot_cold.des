###############################################################################
# Dungeon Crawl Chili: D:6 Thermal Rift
#
# A safe adaptation of Volcano and Ice Cave ideas without portal timers,
# portal exits, or destination-grade loot. A normal Dungeon layout grows
# around this floating primary vault.
###############################################################################

NAME:    dcchili_d6_thermal_rift
PLACE:   D:6
DEPTH:   D:6
WEIGHT:  5000
TAGS:    dcchili_d6_hot_cold no_monster_gen no_item_gen no_pool_fixup no_rotate
ORIENT:  float

# The generated portions of D:6 inherit a mixed temperature population.
MONS:    cinder newt w:10 / bombardier beetle w:7 / fire bat w:4 / \
         white imp w:10 / ice beast w:7 / steam dragon w:3 / \
         marrowcuda w:4

KMONS:   h = fire bat
KMONS:   s = steam dragon
KMONS:   H = hell hound
KMONS:   i = ice beast
KMONS:   p = polar bear
KMONS:   I = rime drake

# The runed specimen rooms each contain a small, themed reward.
KITEM:   f = wand of flame w:4 / scroll of immolation pre_id w:3 / \
             potion of resistance pre_id w:1 / gold w:4
KITEM:   q = wand of iceblast w:2 / potion of resistance pre_id w:2 / \
             any potion w:4 / gold w:4

KFEAT:   x = rock_wall
KFEAT:   c = rock_wall
KFEAT:   m = stone_wall
KFEAT:   G = runed_clear_door
KFEAT:   U = stone_stairs_up_i
KFEAT:   D = stone_stairs_down_i
KFEAT:   l = lava
KFEAT:   w = shallow_water
KPROP:   hsHipI = no_tele_into
KMASK:   hsHipI = opaque
TILE:    x = wall_volcanic
TILE:    c = wall_ice_block
TILE:    m = wall_brick_darkgray
FTILE:   .fhsHl = floor_rough_red
FTILE:   iqwIp = floor_ice
FTILE:   UDG = floor_limestone

