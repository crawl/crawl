{{
function nico_shoals_archipelago_setup(e, ununiq)
    -- the ununiq parameter, if present, means that the primary vault in 
    -- question will be able to appear in the same game as the other primary
    -- vaults, but not on the same level. currently this only applies to the 
    -- 1x1 primary vault
    ununiq = ununiq or false
    e.tags("transparent decor water_ok no_tide luniq_nicotiledpelago")
    -- some of the subvaults have isolated areas that should be no_descent
    -- rather than tag them all individually we're just vetoing the whole thing
    e.tags("no_descent")
    if not ununiq then
       e.tags("uniq_nicotiledpelago")
    end
    e.depth("Shoals")
    e.orient("float")
    local glyphs = "DEFHJKLMNOPQRSZa"
    for i = 1, string.len(glyphs), 1 do
        e.subvault(string.sub(glyphs, i, i) .. " : nico_tilepelago" )
    end
    -- note that this subst is not the same as the one for the subvaults. sorry.
    e.subst("` = _W")
    e.clear("_")
end

function nico_shoals_architile_setup(e)
    e.tags("unrand transparent no_dump water_ok no_tide nico_tilepelago")
    e.depth("Shoals")
    -- 1 = plant on dry land, 2 = plant in shallow water
    e.kmons("1 = plant")
    e.kmons("2 = plant")
    e.kfeat("2 = W")
    e.subst("` = W.")
    e.subst("~ = Ww")
    e.subst("- = x.")
end
}}

